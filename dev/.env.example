# Copy to .env and fill in. The mirror service reads this file via docker-compose.

# --- Prod HA (read-only) ---
# Reuse the long-lived token from internal/scripts/expose_ha_entities.py
HA_PROD_URL=https://hass.jordan-office.buckhamduffy.com
HA_PROD_TOKEN=

# --- Dev HA (the local container) ---
# Created during onboarding: Profile → Security → Long-lived access tokens.
# The hostname `homeassistant` resolves inside the docker-compose network.
HA_DEV_URL=http://homeassistant:8123
HA_DEV_TOKEN=

# --- Mirror behavior ---
# Comma-separated entity_ids. Empty = use the built-in alk-advisor list
# (kh_keeper_* + RSDose 1 head 2). Add more as needed.
MIRROR_ENTITIES=

# Set to "false" to disable mirroring without removing the container.
MIRROR_ENABLED=true

# Polling cadence in seconds. KH cadence on prod is 6h, so 60s is plenty.
POLL_INTERVAL_SECONDS=60
